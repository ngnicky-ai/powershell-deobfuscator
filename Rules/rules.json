{
  "version": 2,
  "behaviors": [
    {
      "id": "IEX",
      "category": "실행",
      "name": "동적 코드 실행 (Invoke-Expression)",
      "description": "문자열을 코드로 해석해 즉시 실행합니다. 복호화된 다음 단계 페이로드를 실행하는 전형적인 방식입니다.",
      "mitre": "T1059.001",
      "mitreName": "PowerShell",
      "tactic": "Execution",
      "severity": "High",
      "pattern": "\\bInvoke-Expression\\b|(?<![\\w-])iex(?![\\w-])",
      "examples": [
        "iex $payload",
        "$x | Invoke-Expression"
      ],
      "counterExamples": [
        "$iexplorePath = 'C:\\x'",
        "Get-Item .\\iex-notes.txt"
      ]
    },
    {
      "id": "SBC",
      "category": "실행",
      "name": "스크립트 블록 동적 생성/실행",
      "description": "[ScriptBlock]::Create 또는 InvokeScript 로 문자열을 코드로 바꿔 실행합니다 (iex 탐지 회피 기법).",
      "mitre": "T1059.001",
      "mitreName": "PowerShell",
      "tactic": "Execution",
      "severity": "High",
      "pattern": "ScriptBlock\\]::Create|NewScriptBlock|InvokeScript|\\[ScriptBlock\\]\\s*\\$",
      "examples": [
        "[ScriptBlock]::Create($s)",
        "InvokeCommand.InvokeScript($c)"
      ],
      "counterExamples": [
        "$sb = { Get-Date }"
      ]
    },
    {
      "id": "ENC",
      "category": "실행",
      "name": "인코딩된 명령 실행 (-EncodedCommand)",
      "description": "Base64(UTF-16LE)로 인코딩한 명령을 실행하여 명령줄 내용을 숨깁니다.",
      "mitre": "T1027.010",
      "mitreName": "Command Obfuscation",
      "tactic": "Defense Evasion",
      "severity": "Medium",
      "pattern": "(?<=\\s)-(e|ec|enc|encodedcommand)\\s+[A-Za-z0-9+/=]{16,}",
      "examples": [
        "powershell -enc SQBFAFgAIAAoACcAaABpACcAKQA=",
        "powershell.exe -EncodedCommand SQBFAFgAIAAoACcAaABpACcAKQA="
      ],
      "counterExamples": [
        "Get-Content -Encoding UTF8 a.txt"
      ]
    },
    {
      "id": "HID",
