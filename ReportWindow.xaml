<Window x:Class="PsDeobfuscator.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Width="900" Height="640" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False">
    <Grid x:Name="Root" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText" FontWeight="Bold" Foreground="#111"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadText" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="SubText" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
            <ae:TextEditor x:Name="Body" IsReadOnly="True" ShowLineNumbers="False" Background="{StaticResource CodeBgBrush}"
                           Foreground="#D6DAF0" FontFamily="{StaticResource CodeFont}" FontSize="12.5" Padding="12,10"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource BaseButton}" Click="OnCopy" Margin="0,0,8,0">
                <TextBlock Text="복사"/>
            </Button>
            <Button Style="{StaticResource BaseButton}" Click="OnSave" Margin="0,0,8,0">
                <TextBlock Text="파일로 저장"/>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Click="OnClose" Padding="18,7" IsCancel="True">
                <TextBlock Text="닫기" Foreground="White"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
